#!/sbin/openrc-run
name="git-daemon"
command="/usr/bin/git"
command_background=true
pidfile="${XDG_RUNTIME_DIR:?必须提供实例运行目录}/git-daemon.pid"

# 在后台启动之前读取并验证配置；只读取数据行，不 source 或 eval 配置输出。
start_pre() {
    local effective_config
    effective_config=$("${INSTALL_ROOT:?必须提供独立程序安装路径}/git-daemon-config.sh") || return $?
    {
        IFS= read -r GIT_PORT
        IFS= read -r LISTEN_ADDRESS
        IFS= read -r TZ
    } <<EOF
$effective_config
EOF
    export TZ
    unset GITHUB_TOKEN GITHUB_TOKEN_FILE
    command_args="daemon --reuseaddr --base-path=${RUN_ROOT:?必须提供实例运行根}/repos --export-all --informative-errors --verbose --listen=${LISTEN_ADDRESS} --port=${GIT_PORT}"
    return 0
}
