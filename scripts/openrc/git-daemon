#!/sbin/openrc-run
name="git-daemon"
command="/usr/bin/git"
command_args="daemon --reuseaddr --base-path=${MIRROR_ROOT:-/srv/git-mirror} --export-all --informative-errors --verbose --listen=${LISTEN_ADDRESS:-0.0.0.0} --port=${GIT_PORT:-9418}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
